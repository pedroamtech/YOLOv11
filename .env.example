# Copy this file to .env (repo root) and fill in your real values.
# .env is already covered by the ".env" rule in .gitignore — never commit the real file.

# https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Single, shared W&B project for both experiments (e.g. an existing "YOLOv11" project in your
# account) — used unless --project is passed explicitly on the command line. Base vs. augmented
# runs are told apart by --name (base_run / augmented_run), not by separate projects.
WANDB_PROJECT=YOLOv11
