# Copy this file to .env (repo root) and fill in your real values.
# .env is already covered by the ".env" rule in .gitignore — never commit the real file.

# https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here

# Fallback project name used only if --project is omitted on the command line. To keep the two
# experiments in separate W&B projects (as required), pass --project explicitly each run, e.g.
# --project VisDrone-YOLO11L-Base and --project VisDrone-YOLO11L-Augmented.
WANDB_PROJECT=VisDrone-YOLO11L
